<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_beige"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/summary_hint"
        android:textColor="@color/text_dark"
        android:textSize="12sp" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/chart_pager"
        android:layout_width="match_parent"
        android:layout_height="274dp"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chart_previous"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:contentDescription="Previous graph"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/olive"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/chart_position"
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1 of 3"
            android:textColor="@color/text_dark"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chart_next"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:contentDescription="Next graph"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/olive"
            android:textSize="30sp" />
    </LinearLayout>
</LinearLayout>
