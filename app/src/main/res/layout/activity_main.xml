<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    tools:context=".MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- bottom navigation -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:layout_width="234dp"
            android:layout_height="67dp"
            android:layout_gravity="start|bottom">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/nav_bg" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/nav_home"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Home"
                    android:padding="16dp"
                    android:src="@drawable/nav_home_on" />

                <ImageView
                    android:id="@+id/nav_calendar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Calendar"
                    android:padding="15dp"
                    android:src="@drawable/nav_calendar_off" />

                <ImageView
                    android:id="@+id/nav_profile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Profile"
                    android:padding="14dp"
                    android:src="@drawable/nav_profile_off" />
            </LinearLayout>
        </FrameLayout>

        <ImageView
            android:id="@+id/fab_write"
            android:layout_width="67dp"
            android:layout_height="67dp"
            android:layout_gravity="end|bottom"
            android:contentDescription="Write today's entry"
            android:src="@drawable/entry_logo" />
    </FrameLayout>
</FrameLayout>
